@PointClass color(255 60 60) size(-8 -8 0, 8 8 16) = npc_turret : "Automatic machine-gun turret (single player, auto_mg). Off until the alarm: script alarm on / alarm off, or turret NAME on|off."
[
    angle(integer) : "Facing (degrees)" : 0
    yaw_min(string) : "Arc left limit (degrees, campaign -30 to -90)" : "-90"
    yaw_max(string) : "Arc right limit (degrees, campaign 30 to 90)" : "90"
    rate(string) : "Seconds between shots (campaign 0.08 to 0.2)" : "0.1"
    health(string) : "Health (campaign 500 to 10000)" : "1000"
    targetname(string) : "Name for the script command turret NAME on|off" : ""
    friendly(choices) : "Side" : 0 = [ 0 : "Enemy (shoots the player)" 1 : "Player's side (shoots enemies, like level 1's)" ]
    active(choices) : "On from the start (otherwise off until the script's alarm on / turret NAME on)" : 0 = [ 0 : "No" 1 : "Yes" ]
]

@PointClass color(80 200 255) size(-8 -8 -8, 8 8 8) = ambient_sound : "Positional sound (single player). Full volume within radius, fading out to silence at falloff. wav = a stock sound file name (see docs) or a .wav in a sounds folder next to the map (PCM .wav, 22050 or 44100 Hz). Script: sound NAME on|off."
[
    wav(string) : "Sound file (.wav)" : ""
    volume(string) : "Volume 0-1" : "1"
    radius(string) : "Full-volume radius (map units)" : "300"
    falloff(string) : "Silent beyond this distance (map units; blank = 2 x radius)" : ""
    loop(choices) : "Repeat" : 1 = [ 1 : "Loop" 0 : "Play once" ]
    start_on(choices) : "Plays from the start" : 1 = [ 1 : "Yes" 0 : "No (until the script's sound NAME on)" ]
    targetname(string) : "Name for the script command sound NAME on|off" : ""
]

