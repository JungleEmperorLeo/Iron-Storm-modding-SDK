// Iron Storm entity definitions for TrenchBroom (converted by map2is.py)
// Units: 1 TrenchBroom unit = 1 Iron Storm unit. Floors in the stock maps sit 36 units apart per storey.

@SolidClass = worldspawn : "World"
[
    sky(string) : "Sky (set_sky name)" : "sky_LV_01"
    ambient(string) : "Base light level 0-255 (only used when light entities exist)" : "64"
    scale(string) : "Game units per map unit (player is about 27 game units tall = 72 map units)" : "0.375"
    shadows(choices) : "Lights cast shadows" : 1 = [ 1 : "Yes" 0 : "No" ]
    lightgrid(string) : "Wall/floor subdivision for lighting, smaller = smoother but heavier" : "192"
    start_weapons(string) : "Starting weapons (single player), e.g. knife handgun smg shotgun sniper mg rocket launcher flamethrower; blank = knife smg sniper shotgun" : ""
    start_ammo(string) : "Starting ammo pairs, e.g. mg 100 shotgun 20 (ammo: mg = smg + machine gun, sniper, shotgun, handgun, launcher, rocket, flamethrower); blank = mg 50 sniper 4 shotgun 10" : ""
    player_model(string) : "Player body model (single player; an npc_soldier model name, blank = normal)" : ""
    music(string) : "Music (single player): a .wav that loops everywhere, same volume all over the level. A stock sound name or a .wav in the map's sounds folder. Script: music on|off" : ""
    music_volume(string) : "Music volume 0-1" : "1"
    music_start(choices) : "Music plays from the start" : 1 = [ 1 : "Yes" 0 : "No (until the script's music on)" ]
]

@SolidClass = func_detail : "Detail brushes (drawn and solid, same as world)" []
@SolidClass color(120 120 255) = func_sector : "Room volume. Each brush is one sector (rooms must touch, not overlap). Use special/skip." []
@SolidClass = func_group : "Group (same as world)" []

@baseclass = Angle [ angle(integer) : "Facing (degrees, 0 = +X)" : 0 ]

@SolidClass color(255 40 40) = trigger_kill : "Kill zone (single player / campaign Test slot only). Anything that enters the volume dies (with an explosion). Use the special/trigger texture. Make it tall enough to cover a standing character." []

@SolidClass color(0 255 0) = trigger_end : "Level end (single player / campaign Test slot only). When the player enters, the level ends and the game moves on to campaign level 'next'. Use special/trigger."
[
    next(integer) : "Campaign level to go to" : 0
]

@SolidClass color(255 160 0) = trigger_script : "Script zone (campaign Test slot / chain levels). When the player enters, the matching block of <map>.script runs (on enter <name> ...). Use special/trigger."
[
    targetname(string) : "Name used in the .script file" : ""
]

@SolidClass color(0 200 255) = trigger_weather : "Weather / sky zone (campaign Test slot / chain levels). When the player walks in, the 'enter' atmosphere and sky are applied; when the player walks out, the 'exit' ones. Leave a key empty to leave that part unchanged. Use special/trigger."
[
    enter_atmosphere(string) : "On enter: atmosphere (neige, rain, tempete, space)" : ""
    exit_atmosphere(string) : "On exit: atmosphere (space = none)" : ""
    enter_sky(string) : "On enter: sky model (sky_LV_01, sky_LV_02, sky_LV_03, sky_LV_05 ...)" : ""
    exit_sky(string) : "On exit: sky model" : ""
    enter_fog(string) : "On enter: switch to the env_fog with this targetname" : ""
    exit_fog(string) : "On exit: switch to the env_fog with this targetname" : ""
]

@PointClass color(180 200 220) size(-8 -8 -8, 8 8 8) = env_fog : "Map fog (single player). Use several and switch between them with trigger_weather enter_fog / exit_fog (the game cannot change a fog colour while running). Colour 0-1 or 0-255. The campaign uses light grey (0.85), dark blue (0.1 0.1 0.15), white (1 1 1) and black for caves."
[
    targetname(string) : "Name (for trigger_weather enter_fog / exit_fog and the script fog command). The first env_fog in the map starts on, the others off." : ""
    color(string) : "Fog colour (r g b)" : "0.85 0.85 0.85"
    near(integer) : "Fog start distance" : 400
    far(integer) : "Fog end distance" : 4000
    height_a(integer) : "Height setting A (stock level 1: -400)" : -400
    height_b(integer) : "Height setting B (stock level 1: 800)" : 800
]

@PointClass color(200 200 255) size(-8 -8 -8, 8 8 8) = env_particle : "Ready-made particle effect (single player): steam, gas jet. Placed at the origin; 'angles' is pitch yaw roll in degrees (stock values look like 0 -90 -10)."
[
    effect(choices) : "Effect" : "steam" =
    [
        "steam" : "Steam / vapor (pot, pipe)"
        "gas" : "Gas jet (large)"
        "gas_small" : "Gas jet (small)"
    ]
    scale(string) : "Scale (empty = default for the effect)" : ""
    angles(string) : "Angles (pitch yaw roll)" : "0 0 0"
]

@PointClass color(160 120 80) size(-8 -8 -8, 8 8 8) = prop_static : "A model placed in the level (single player): any stock model from Models.lst (see STOCK_MODELS.md) or a model in the map's models folder. Origin is the model's pivot; test placement per model."
[
    model(string) : "Model file name (with or without .4x3)" : "OBJ_bidon"
    mode(choices) : "Behaviour" : "static" =
    [
        "static" : "Static (not destructible)"
        "breakable" : "Breakable (barrel/crate behaviour of the campaign)"
        "crate" : "Wooden crate (OBJ_obj-caisse_cassable, OBJ_malle-cassable)"
        "metal_crate" : "Metal / plastic crate (OBJ_caisse-metal_cassable, OBJ_caisse_plastique_cassable)"
        "vent" : "Vent grille (OBJ_grille_aeration)"
        "plank" : "Wooden plank (obj_planche)"
    ]
    drop(string) : "Contents (space separated): medikit, small_medikit, mg_ammo, sniper_ammo, shotgun_ammo, handgun_ammo, launcher_ammo, rocket_ammo, flame_ammo, mg3_ammo, or an item number. Breakable modes only" : ""
    drop_health(integer) : "Medikit inside (0 = none, 1 = small, 2+ = medikit; breakable modes only)" : 0
    angles(string) : "Rotation (pitch yaw roll, degrees)" : "0 0 0"
    node(string) : "Node name inside the model (empty = whole model)" : ""
]

@SolidClass color(255 120 0) = func_button : "Button / lever: the brush is drawn and solid like func_detail; when the player presses use near its centre the 'on use <targetname>' block of the .script runs (campaign Test slot / chain levels). Set angle to the way the button faces."
[
    targetname(string) : "Name used in the .script file" : ""
    angle(integer) : "Facing (yaw)" : 0
    range(integer) : "Use range (map units, 0 = default)" : 0
    cone(integer) : "Use angle (degrees, default 90)" : 90
]

@SolidClass color(0 200 255) = trigger_save : "Autosave checkpoint (single player / campaign Test slot only). The game autosaves when the player enters. Use special/trigger." []

@SolidClass color(30 120 255) = func_water : "Water volume. Only the top face is drawn, not solid. Floors under it get water footsteps and impacts. Single player / campaign slots: the engine's own water (the surface ripples and slides like the stock levels'); multiplayer: a flat translucent plane (opacity = worldspawn glass_opacity). Texture the top face with any texture (it is drawn translucent)."
[
    tint(string) : "Water colour (r g b, 0-1 or 0-255). Default: the texture's average colour, darkened" : ""
    speed(string) : "Ripple strength (stock levels use 0.05 to 0.5)" : "0.15"
    opacity(string) : "Surface opacity 0-1 (default: worldspawn glass_opacity, else 0.6)" : ""
    grid(string) : "Ripple mesh cell size in map units (smaller = smoother, heavier)" : "24"
    depth(string) : "Engine water value 5 (stock levels use 10 to 25; level 1 uses -200)" : "10"
    height(string) : "Engine water value 6 (stock levels use 50 to 65)" : "50"
    effect(string) : "0 = old flat plane even in single player" : "1"
]

@PointClass base(Angle) color(0 160 255) size(-40 -8 0, 40 8 104) = door : "Sliding door, stock model (single player / campaign Test slot only). Opens when someone comes near. Origin = bottom centre; angle = the way the door faces (it spans left-right across it)."
[
    model(choices) : "Model" : "blindee" =
    [
        "blindee" : "Armoured door (80 x 103 map units)"
        "std" : "Standard door (32 x 69)"
        "bunker" : "Bunker door (32 x 67)"
        "cell" : "Cell door (39 x 87)"
        "gare" : "Station door (174 x 95)"
        "lift" : "Lift door, metal (27 x 80)"
        "sas" : "Airlock door (56 x 136)"
    ]
    slide(choices) : "Opens towards" : "left" =
    [
        "left" : "Left"
        "right" : "Right"
        "up" : "Up"
        "down" : "Down"
    ]
    distance(integer) : "Slide distance (map units, 0 = its own width/height)" : 0
    speed(string) : "Speed" : "0.3"
    wait(string) : "Seconds before closing (-1 = stays open)" : "3"
    range(string) : "Opening distance (game units)" : "50"
    targetname(target_source) : "Name (for script open / close)"
    locked(choices) : "Opens by itself" : 0 =
    [
        0 : "Yes, when someone comes near"
        1 : "No, only when the script says open"
    ]
]

