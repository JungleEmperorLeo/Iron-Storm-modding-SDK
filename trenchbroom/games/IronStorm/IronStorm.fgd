@PointClass color(90 140 255) size(-24 -24 -12, 24 24 12) = npc_helicopter : "EXPERIMENTAL, orders do not work reliably (edit the script by hand with gexpad). Helicopter (single player). It sits at this point until the script steers it: heli_start NAME, heli_move NAME POINT, heli_attack NAME npc, heli_fire / heli_land / heli_takeoff / heli_crash NAME POINT (POINT = a path_corner targetname, or x y z), heli_speed NAME n, heli_stop NAME."
[
    targetname(string) : "Name used in the .script file" : "heli1"
    kind(choices) : "Model" : "allies" = [ "allies" : "Allied transport" "enemy" : "Enemy transport" ]
]
