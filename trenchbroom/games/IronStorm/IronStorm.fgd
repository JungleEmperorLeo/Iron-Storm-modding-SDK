    range(string) : "Detection range (empty = 200)" : ""
    health(string) : "Health (empty = 50)" : ""
    damage(string) : "Bite damage (empty = 20)" : ""
]

@PointClass color(120 120 120) size(-8 -8 0, 8 8 16) = weapon_mounted_mg : "Mounted gun the player can use (single player). Settings copy the campaign's guns of that kind."
[
    angle(integer) : "Facing (degrees)" : 0
    kind(choices) : "Model" : "bunker" =
    [
        "bunker" : "Bunker machine gun (FMG_mitrailleuse_bunker)"
        "handles" : "Machine gun with handles (FMG_poignees)"
        "launcher" : "Launcher, no stand (FMG_launcher_sans_pied)"
        "launcher_stand" : "Launcher on a stand (FMG_launcher_avec_pied)"
